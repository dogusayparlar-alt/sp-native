<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 35+: statusBarColor / navigationBarColor are deprecated under forced edge-to-edge; the ground colour alone remains. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
