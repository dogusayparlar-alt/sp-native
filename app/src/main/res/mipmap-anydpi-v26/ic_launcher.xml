<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon sits on the game's own ground, not on white: the seal is
     a gold ring, and a white plate behind it reads as a different mark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ground" />
    <foreground>
        <inset android:drawable="@mipmap/ic_maskable" android:inset="16%" />
    </foreground>
</adaptive-icon>
