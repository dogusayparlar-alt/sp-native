<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window is the game's own black, so there is no white flash
         between the icon tap and the first frame the WebView paints. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
